{% from _self import pw_field, badge %}

{# ── Macros ───────────────────────────────────────────────────────────────── #}
{% macro pw_field(name, placeholder, saved) %}
{% set ph = saved ? __('Saved — leave empty to keep', 'gdmsintegration') : placeholder %}
<div class="input-group">
    <input type="password" class="form-control gdms-pw" name="{{ name }}"
           id="gdms_pw_{{ name }}" autocomplete="new-password" placeholder="{{ ph }}">
    <button type="button" class="btn btn-outline-secondary gdms-pw-toggle"
            data-target="gdms_pw_{{ name }}" tabindex="-1">
        <i class="ti ti-eye"></i>
    </button>
</div>
{% endmacro %}

{% macro badge(ok) %}
{# Keep configuration status badges visually consistent with the device-status badges used by the dashboard. #}
{% if ok %}<span class="badge bg-success text-white fw-semibold">{{ __('Connected', 'gdmsintegration') }}</span>{% else %}<span class="badge bg-warning text-dark fw-semibold">{{ __('Not configured', 'gdmsintegration') }}</span>{% endif %}
{% endmacro %}

<div class="container-fluid px-4 mt-3">

   <form id="main-config-form" method="post" action="">

   {# ── Entity ──────────────────────────────────────────────────── #}
   <div class="row mb-4">
      <div class="col-md-4">
         <p class="form-label fw-semibold mb-1">{{ __('Entity', 'gdmsintegration') }}</p>
         {{ entity_dropdown|raw }}
         <small class="text-muted d-block mt-1">{{ __('GLPI entity this configuration applies to.', 'gdmsintegration') }}</small>
      </div>
   </div>

   {# ── Plugin updates ───────────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2">
         <i class="ti ti-brand-github"></i>
         <h5 class="mb-0">{{ __('Plugin updates', 'gdmsintegration') }}</h5>
      </div>
      <div class="card-body">
         {% if plugin_update.update_available %}
         <div class="alert alert-warning d-flex align-items-start gap-2 mb-0">
            <i class="ti ti-download mt-1 flex-shrink-0"></i>
            <div>
               <div class="fw-semibold">{{ __('A new plugin version is available.', 'gdmsintegration') }}</div>
               <div>
                  {{ __('Installed version:', 'gdmsintegration') }} <strong>{{ plugin_update.current_version }}</strong>
                  · {{ __('Latest version:', 'gdmsintegration') }} <strong>{{ plugin_update.latest_version }}</strong>
               </div>
               {% if plugin_update.release_url %}
               <a class="btn btn-sm btn-warning mt-2" href="{{ plugin_update.release_url }}" target="_blank" rel="noopener">
                  <i class="ti ti-external-link me-1"></i>{{ __('View release', 'gdmsintegration') }}
               </a>
               {% endif %}
            </div>
         </div>
         {% elseif plugin_update.latest_version %}
         <div class="d-flex align-items-center gap-2">
            <i class="ti ti-circle-check text-success"></i>
            <div>
               <div class="fw-semibold">{{ __('Plugin is up to date.', 'gdmsintegration') }}</div>
               <div class="text-muted small">
                  {{ __('Installed version:', 'gdmsintegration') }} <strong>{{ plugin_update.current_version }}</strong>
                  · {{ __('Latest version:', 'gdmsintegration') }} <strong>{{ plugin_update.latest_version }}</strong>
               </div>
            </div>
         </div>
         {% else %}
         <div class="text-muted d-flex align-items-center gap-2">
            <i class="ti ti-cloud-off"></i>
            <span>{{ __('The latest plugin version could not be checked right now. Your configuration is not affected.', 'gdmsintegration') }}</span>
         </div>
         {% endif %}
         {% if plugin_update.checked_at %}
         <div class="text-muted small mt-2">
            {{ __('Last checked:', 'gdmsintegration') }} {{ plugin_update.checked_at|date('Y-m-d H:i') }}
         </div>
         {% endif %}
      </div>
   </div>

   {# ── GDMS Account ─────────────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2">
         <i class="ti ti-user-shield"></i>
         <h5 class="mb-0">{{ __('GDMS Account', 'gdmsintegration') }}</h5>
      </div>
      <div class="card-body">
         <p class="text-muted mb-3">{{ __('Your gdms.cloud login credentials. Used to authenticate against the GDMS API.', 'gdmsintegration') }}</p>
         <div class="row g-3">
            <div class="col-md-6">
               <label class="form-label fw-semibold" for="gdms_username">{{ __('GDMS Username', 'gdmsintegration') }}</label>
               <input type="text" class="form-control" name="username" id="gdms_username"
                  value="{{ cur.username ?? '' }}" autocomplete="off"
                  placeholder="{{ __('Your gdms.cloud username', 'gdmsintegration') }}">
               <small class="text-muted d-block mt-1">{{ __('Username (not email) to sign in to gdms.cloud.', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-6">
               <label class="form-label fw-semibold" for="gdms_pw_password">{{ __('GDMS Password', 'gdmsintegration') }}</label>
               {{ pw_field('password', __('Your gdms.cloud password', 'gdmsintegration'), cur.password is not empty) }}
               <small class="text-muted d-block mt-1">{{ __('Your gdms.cloud login password. Stored encrypted.', 'gdmsintegration') }}</small>
            </div>
         </div>
      </div>
   </div>

   {# ── GWN Networking ───────────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center justify-content-between">
         <div class="d-flex align-items-center gap-2">
            <i class="ti ti-network"></i>
            <h5 class="mb-0">{{ __('GDMS Networking — APs, Switches & Routers', 'gdmsintegration') }}</h5>
         </div>
         {{ badge(has_gwn) }}
      </div>
      <div class="card-body">
         <div class="alert alert-info d-flex gap-2 align-items-start mb-3">
            <i class="ti ti-info-circle mt-1 flex-shrink-0"></i>
            <span>
               {{ __('Syncs GWN APs, switches and routers. No username or password required — only API credentials.', 'gdmsintegration') }}
               {{ __('Credentials from', 'gdmsintegration') }}
               <a href="https://www.gdms.cloud/developer" target="_blank" rel="noopener">gdms.cloud → GDMS Networking → API Developer</a>.
            </span>
         </div>
         <div class="row g-3">
            <div class="col-md-6">
               <label class="form-label fw-semibold" for="gdms_gwn_client_id">{{ __('API ID', 'gdmsintegration') }}</label>
               <input type="text" class="form-control" name="gwn_client_id" id="gdms_gwn_client_id"
                  value="{{ cur.gwn_client_id ?? '' }}" autocomplete="off"
                  placeholder="{{ __('API ID from GWN developer page', 'gdmsintegration') }}">
               <small class="text-muted d-block mt-1">{{ __('API ID from gdms.cloud → GDMS Networking → API Developer.', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-6">
               <label class="form-label fw-semibold" for="gdms_pw_gwn_client_secret">{{ __('API Secret Key', 'gdmsintegration') }}</label>
               {{ pw_field('gwn_client_secret', __('Secret Key from GWN developer page', 'gdmsintegration'), cur.gwn_client_secret is not empty) }}
               <small class="text-muted d-block mt-1">{{ __('API Secret Key from gdms.cloud → GDMS Networking → API Developer. Stored encrypted.', 'gdmsintegration') }}</small>
            </div>
         </div>
      </div>
   </div>

   {# ── GDMS UC/VoIP ──────────────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center justify-content-between">
         <div class="d-flex align-items-center gap-2">
            <i class="ti ti-phone"></i>
            <h5 class="mb-0">{{ __('GDMS Unified Communications — Phones & PBX', 'gdmsintegration') }}</h5>
         </div>
         {{ badge(has_gdms) }}
      </div>
      <div class="card-body">
         <div class="alert alert-info d-flex gap-2 align-items-start mb-3">
            <i class="ti ti-info-circle mt-1 flex-shrink-0"></i>
            <span>
               {{ __('Syncs GRP, GXP, GXV, WP phones and UCM PBX appliances.', 'gdmsintegration') }}
               {{ __('Credentials from', 'gdmsintegration') }}
               <a href="https://www.gdms.cloud/developer" target="_blank" rel="noopener">gdms.cloud → System → API Development</a>.
            </span>
         </div>
         <div class="row g-3 mb-1">
            <div class="col-md-6">
               <label class="form-label fw-semibold" for="gdms_region">{{ __('GDMS account region', 'gdmsintegration') }}</label>
               <select class="form-select" name="gdms_region" id="gdms_region">
                  <option value="us"{% if (cur.gdms_region ?? 'us') == 'us' %} selected{% endif %}>{{ __('United States / Americas (www.gdms.cloud)', 'gdmsintegration') }}</option>
                  <option value="eu"{% if (cur.gdms_region ?? 'us') == 'eu' %} selected{% endif %}>{{ __('Europe (eu.gdms.cloud)', 'gdmsintegration') }}</option>
               </select>
               <small class="text-muted d-block mt-1">{{ __('Select the region where the GDMS Unified Communications account is hosted. The endpoint is fixed by the plugin for security.', 'gdmsintegration') }}</small>
            </div>
         </div>
         <div class="row g-3">
            <div class="col-md-6">
               <label class="form-label fw-semibold" for="gdms_client_id">{{ __('API ID', 'gdmsintegration') }}</label>
               <input type="text" class="form-control" name="client_id" id="gdms_client_id"
                  value="{{ cur.client_id ?? '' }}" autocomplete="off"
                  placeholder="{{ __('API ID from GDMS developer page', 'gdmsintegration') }}">
               <small class="text-muted d-block mt-1">{{ __('API ID shown in GDMS → System → API Development.', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-6">
               <label class="form-label fw-semibold" for="gdms_pw_client_secret">{{ __('API Secret Key', 'gdmsintegration') }}</label>
               {{ pw_field('client_secret', __('Secret Key from GDMS developer page', 'gdmsintegration'), cur.client_secret is not empty) }}
               <small class="text-muted d-block mt-1">{{ __('API Secret Key from GDMS → System → API Development. Stored encrypted.', 'gdmsintegration') }}</small>
            </div>
         </div>
      </div>
   </div>

   {# ── Dashboard & Tickets ───────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2">
         <i class="ti ti-dashboard"></i>
         <h5 class="mb-0">{{ __('Dashboard & Tickets', 'gdmsintegration') }}</h5>
      </div>
      <div class="card-body">
         <div class="row g-3">
            <div class="col-md-4">
               <label class="form-label fw-semibold" for="gdms_chart_days">{{ __('Availability chart — days to display', 'gdmsintegration') }}</label>
               <input type="number" class="form-control" name="chart_days" id="gdms_chart_days"
                  min="7" max="365" value="{{ chart_days }}">
               <small class="text-muted d-block mt-1">{{ __('Recommended: 60 days. Values above 90 days may slow down the dashboard due to larger history queries.', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-4">
               <label class="form-label fw-semibold" for="gdms_ticket_requester_id">{{ __('Ticket requester (user)', 'gdmsintegration') }}</label>
               <select class="form-select" name="ticket_requester_id" id="gdms_ticket_requester_id">
                  <option value="0">{{ __('System / cron user (default)', 'gdmsintegration') }}</option>
                  {% for user in users_options %}
                  <option value="{{ user.id }}"{% if user.selected %} selected{% endif %}>{{ user.label }}</option>
                  {% endfor %}
               </select>
               <small class="text-muted d-block mt-1">{{ __('This user will be set as the requester on automatically generated incident tickets.', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-4">
               <label class="form-label fw-semibold d-block" for="gdms_show_topology">{{ __('Network topology card', 'gdmsintegration') }}</label>
               <div class="form-check form-switch mt-2">
                  <input class="form-check-input" type="checkbox" name="show_topology"
                         id="gdms_show_topology" value="1"
                         {% if show_topology == 1 %}checked{% endif %}>
                  <label class="form-check-label" for="gdms_show_topology">
                     {{ __('Show topology card on dashboard', 'gdmsintegration') }}
                  </label>
               </div>
               <small class="text-muted d-block mt-1">{{ __('When disabled, the topology graph is hidden and its data processing is skipped entirely.', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-4">
               <label class="form-label fw-semibold" for="gdms_ip_version">{{ __('Private IP display', 'gdmsintegration') }}</label>
               <select class="form-select mt-1" name="ip_version" id="gdms_ip_version">
                  <option value="ipv4"{% if ip_version == 'ipv4' %} selected{% endif %}>{{ __('IPv4 (preferred, fallback to IPv6)', 'gdmsintegration') }}</option>
                  <option value="ipv6"{% if ip_version == 'ipv6' %} selected{% endif %}>{{ __('IPv6 (preferred, fallback to IPv4)', 'gdmsintegration') }}</option>
               </select>
               <small class="text-muted d-block mt-1">{{ __('Which address to show in the Private IP column. If the preferred version is unavailable for a device, the other is shown as fallback.', 'gdmsintegration') }}</small>
            </div>
         </div>
         <div class="row g-3 mt-1">
            <div class="col-md-6">
               <label class="form-label fw-semibold" for="gdms_ticket_category_network_id">{{ __('Ticket category — network equipment', 'gdmsintegration') }}</label>
               <select class="form-select" name="ticket_category_network_id" id="gdms_ticket_category_network_id">
                  <option value="0">{{ __('Do not assign a category', 'gdmsintegration') }}</option>
                  {% for category in ticket_category_options %}
                  <option value="{{ category.id }}"{% if category.id == ticket_category_network_id %} selected{% endif %}>{{ category.label|e }}</option>
                  {% endfor %}
               </select>
               <small class="text-muted d-block mt-1">{{ __('Applied to automatically generated tickets for routers, switches, access points and WAN failures.', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-6">
               <label class="form-label fw-semibold" for="gdms_ticket_category_telephony_id">{{ __('Ticket category — Grandstream telephony', 'gdmsintegration') }}</label>
               <select class="form-select" name="ticket_category_telephony_id" id="gdms_ticket_category_telephony_id">
                  <option value="0">{{ __('Do not assign a category', 'gdmsintegration') }}</option>
                  {% for category in ticket_category_options %}
                  <option value="{{ category.id }}"{% if category.id == ticket_category_telephony_id %} selected{% endif %}>{{ category.label|e }}</option>
                  {% endfor %}
               </select>
               <small class="text-muted d-block mt-1">{{ __('Applied to automatically generated tickets for IP phones and PBX/UCM devices.', 'gdmsintegration') }}</small>
            </div>
         </div>
         <div class="row g-3 mt-1">
            <div class="col-md-4">
               <label class="form-label fw-semibold" for="gdms_refresh_interval">{{ __('Dashboard auto-refresh (seconds)', 'gdmsintegration') }}</label>
               <input type="number" class="form-control" name="refresh_interval" id="gdms_refresh_interval"
                  min="30" max="3600" value="{{ refresh_interval }}">
               <small class="text-muted d-block mt-1">{{ __('How often the dashboard syncs from the cloud. Minimum 30s, default 300s (5 min).', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-4">
               <label class="form-label fw-semibold" for="gdms_history_retention">{{ __('Operational history retention (days)', 'gdmsintegration') }}</label>
               <input type="number" class="form-control" name="history_retention_days" id="gdms_history_retention" min="7" max="3650" value="{{ history_retention_days }}">
               <small class="text-muted d-block mt-1">{{ __('Keeps client association and action audit history for this many days. Default: 90.', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-4">
               <label class="form-label fw-semibold" for="gdms_debug_logging">{{ __('Debug logging', 'gdmsintegration') }}</label>
               <div class="form-check form-switch mt-1">
                  <input class="form-check-input" type="checkbox" name="debug_logging"
                         id="gdms_debug_logging" value="1"
                         {% if (cur.debug_logging ?? 0)|number_format == 1 %}checked{% endif %}>
                  <label class="form-check-label" for="gdms_debug_logging">
                     {{ __('Verbose logging (debug mode)', 'gdmsintegration') }}
                  </label>
               </div>
               <small class="text-muted d-block mt-1">{{ __('Enable verbose API and sync logging. Recommended only for troubleshooting — generates large log entries.', 'gdmsintegration') }}</small>
               <small class="text-muted d-block">{{ __('When disabled, only errors and key sync results are logged.', 'gdmsintegration') }}</small>
            </div>
         </div>
         <div class="row g-3 mt-1">
            <div class="col-md-4">
               <label class="form-label fw-semibold" for="gdms_wan_debounce">{{ __('WAN no-internet debounce (seconds)', 'gdmsintegration') }}</label>
               <input type="number" class="form-control" name="wan_debounce_seconds" id="gdms_wan_debounce"
                  min="0" max="3600" value="{{ wan_debounce_seconds }}">
               <small class="text-muted d-block mt-1">{{ __('Seconds to wait before opening a "no internet" WAN ticket. Prevents false alerts from transient high-latency events. 0 = open immediately. Default: 300.', 'gdmsintegration') }}</small>
            </div>
            <div class="col-md-4">
               <label class="form-label fw-semibold d-block" for="gdms_wan_tickets_enabled">{{ __('Create WAN port tickets', 'gdmsintegration') }}</label>
               <div class="form-check form-switch mt-2">
                  <input class="form-check-input" type="checkbox" name="wan_tickets_enabled"
                         id="gdms_wan_tickets_enabled" value="1"
                         {% if wan_tickets_enabled == 1 %}checked{% endif %}>
                  <label class="form-check-label" for="gdms_wan_tickets_enabled">
                     {{ __('Open tickets on WAN port failures', 'gdmsintegration') }}
                  </label>
               </div>
               <small class="text-muted d-block mt-1">{{ __('When enabled, the plugin automatically opens incident tickets when a WAN port reports link-down or internet loss. Disable to suppress all WAN port alert tickets.', 'gdmsintegration') }}</small>
            </div>
         </div>
      </div>
   </div>

   {# ── Ticket types ──────────────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2">
         <i class="ti ti-ticket"></i>
         <h5 class="mb-0">{{ __('Ticket creation by device type', 'gdmsintegration') }}</h5>
      </div>
      <div class="card-body">
         <p class="text-muted mb-3">{{ __('Controls which device types trigger offline incident tickets when they go offline. All types are enabled by default.', 'gdmsintegration') }}</p>
         <div class="row g-3">
            <div class="col-md-4 col-lg-2">
               <div class="form-check form-switch mt-1">
                  <input class="form-check-input" type="checkbox" name="tickets_phone"
                         id="gdms_tickets_phone" value="1"
                         {% if tickets_phone == 1 %}checked{% endif %}>
                  <label class="form-check-label fw-semibold" for="gdms_tickets_phone">
                     {{ __('IP Phones (GRP, GXP, GXV, WP)', 'gdmsintegration') }}
                  </label>
               </div>
            </div>
            <div class="col-md-4 col-lg-2">
               <div class="form-check form-switch mt-1">
                  <input class="form-check-input" type="checkbox" name="tickets_router"
                         id="gdms_tickets_router" value="1"
                         {% if tickets_router == 1 %}checked{% endif %}>
                  <label class="form-check-label fw-semibold" for="gdms_tickets_router">
                     {{ __('Routers (GWN7001/7002/7003)', 'gdmsintegration') }}
                  </label>
               </div>
            </div>
            <div class="col-md-4 col-lg-2">
               <div class="form-check form-switch mt-1">
                  <input class="form-check-input" type="checkbox" name="tickets_switch"
                         id="gdms_tickets_switch" value="1"
                         {% if tickets_switch == 1 %}checked{% endif %}>
                  <label class="form-check-label fw-semibold" for="gdms_tickets_switch">
                     {{ __('Switches (GWN7800, GSS)', 'gdmsintegration') }}
                  </label>
               </div>
            </div>
            <div class="col-md-4 col-lg-2">
               <div class="form-check form-switch mt-1">
                  <input class="form-check-input" type="checkbox" name="tickets_ap"
                         id="gdms_tickets_ap" value="1"
                         {% if tickets_ap == 1 %}checked{% endif %}>
                  <label class="form-check-label fw-semibold" for="gdms_tickets_ap">
                     {{ __('Access Points (GWN76xx)', 'gdmsintegration') }}
                  </label>
               </div>
            </div>
            <div class="col-md-4 col-lg-2">
               <div class="form-check form-switch mt-1">
                  <input class="form-check-input" type="checkbox" name="tickets_pbx"
                         id="gdms_tickets_pbx" value="1"
                         {% if tickets_pbx == 1 %}checked{% endif %}>
                  <label class="form-check-label fw-semibold" for="gdms_tickets_pbx">
                     {{ __('IP PBX / UCM (UCM, GCC)', 'gdmsintegration') }}
                  </label>
               </div>
            </div>
         </div>
      </div>
   </div>

   <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_main }}">
   </form>

   {# ── History Import ────────────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2">
         <i class="ti ti-file-import"></i>
         <h5 class="mb-0">{{ __('Import History', 'gdmsintegration') }}</h5>
      </div>
      <div class="card-body">
         <p class="text-muted mb-3">{{ __('Restore availability history from a previously exported XLSX file (gdms_history_*.xlsx). Days that already have data are skipped — no existing records are overwritten.', 'gdmsintegration') }}</p>
         <div class="mb-3" style="max-width:220px">
            <label class="form-label fw-semibold" for="gdms_max_xlsx_size_mb">{{ __('Max upload size (MB)', 'gdmsintegration') }}</label>
            <input type="number" class="form-control" name="max_xlsx_size_mb" id="gdms_max_xlsx_size_mb"
               min="1" max="50" value="{{ max_xlsx_size_mb }}" form="main-config-form">
         </div>
         <form method="post" action="" enctype="multipart/form-data" class="gdms-import-form">
            <div class="d-flex align-items-center gap-3 flex-wrap">
               <input type="file" class="form-control" name="history_xlsx" accept=".xlsx" required style="max-width:340px">
               <button type="submit" name="import_history" value="1" class="btn btn-outline-primary gdms-import-btn">
                  <span class="spinner-border spinner-border-sm d-none me-1 gdms-spin" role="status" aria-hidden="true"></span>
                  <i class="ti ti-upload me-1 gdms-icon"></i>{{ __('Import', 'gdmsintegration') }}
               </button>
            </div>
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_history }}">
         </form>
      </div>
   </div>

   {# ── Configuration Backup ─────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2">
         <i class="ti ti-settings-bolt"></i>
         <h5 class="mb-0">{{ __('Configuration Backup', 'gdmsintegration') }}</h5>
      </div>
      <div class="card-body">
         <p class="text-muted mb-3">{{ __('Export all plugin settings to a JSON file, or restore them from a backup. API credentials and secrets are excluded from exports for security.', 'gdmsintegration') }}</p>
         <div class="d-flex align-items-start gap-4 flex-wrap">
            <div>
               <p class="fw-semibold mb-2">{{ __('Export settings', 'gdmsintegration') }}</p>
               <form method="post" action="" class="gdms-import-form" data-download="1">
                  <input type="hidden" name="entities_id" value="{{ entities_id }}">
                  <div class="form-check mb-2">
                     <input class="form-check-input" type="checkbox" name="include_credentials"
                            id="gdms_export_creds" value="1">
                     <label class="form-check-label" for="gdms_export_creds">
                        {{ __('Include API credentials (username, keys, secrets)', 'gdmsintegration') }}
                     </label>
                  </div>
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_export }}">
                  <button type="submit" name="export_config" value="1" class="btn btn-outline-secondary gdms-import-btn">
                     <span class="spinner-border spinner-border-sm d-none me-1 gdms-spin" role="status" aria-hidden="true"></span>
                     <i class="ti ti-download me-1 gdms-icon"></i>{{ __('Download JSON', 'gdmsintegration') }}
                  </button>
               </form>
            </div>
            <div>
               <p class="fw-semibold mb-2">{{ __('Import settings', 'gdmsintegration') }}</p>
               <form method="post" action="" enctype="multipart/form-data" class="gdms-import-form">
                  <input type="hidden" name="entities_id" value="{{ entities_id }}">
                  <div class="d-flex align-items-center gap-3 flex-wrap">
                     <input type="file" class="form-control" name="config_json" accept=".json" required style="max-width:280px">
                     <button type="submit" name="import_config" value="1" class="btn btn-outline-primary gdms-import-btn">
                        <span class="spinner-border spinner-border-sm d-none me-1 gdms-spin" role="status" aria-hidden="true"></span>
                        <i class="ti ti-upload me-1 gdms-icon"></i>{{ __('Import', 'gdmsintegration') }}
                     </button>
                  </div>
                  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_export }}">
               </form>
            </div>
         </div>
      </div>
   </div>

   <div class="mb-4 d-flex align-items-center gap-3 flex-wrap">
      <button type="submit" name="save" form="main-config-form" class="btn btn-primary px-4">
         <i class="ti ti-device-floppy me-1"></i>{{ __('Save', 'gdmsintegration') }}
      </button>
      {% if has_gdms or has_gwn %}
      <a href="{{ dashboard_url }}" class="btn btn-outline-secondary px-4">
         <i class="ti ti-dashboard me-2"></i>{{ __('Go to Dashboard', 'gdmsintegration') }}
      </a>
      {% endif %}
   </div>

</div>
<script>
document.querySelectorAll('.gdms-pw-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var input = document.getElementById(this.dataset.target);
        if (!input) return;
        input.type = input.type === 'password' ? 'text' : 'password';
        this.querySelector('i').className = input.type === 'password' ? 'ti ti-eye' : 'ti ti-eye-slash';
    });
});
document.querySelectorAll('.gdms-import-form').forEach(function(form) {
    form.addEventListener('submit', function(e) {
        var btn = form.querySelector('.gdms-import-btn');
        if (!btn) return;
        var spin = btn.querySelector('.gdms-spin');
        var icon = btn.querySelector('.gdms-icon');

        if (form.dataset.download) {
            e.preventDefault();
            if (spin) spin.classList.remove('d-none');
            if (icon) icon.classList.add('d-none');
            btn.disabled = true;

            var fd = new FormData(form);
            var submitter = e.submitter || form.querySelector('[type="submit"]');
            if (submitter && submitter.name) fd.append(submitter.name, submitter.value || '1');
            var token = fd.get('_glpi_csrf_token') || '';
            fd.delete('_glpi_csrf_token');

            fetch(location.href, {
                method: 'POST',
                headers: {
                    'X-Glpi-Csrf-Token': token,
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: fd
            }).then(function(r) {
                var cd = r.headers.get('Content-Disposition') || '';
                var m  = cd.match(/filename="([^"]+)"/);
                var fn = m ? m[1] : 'gdms_config.json';
                var newToken = r.headers.get('X-Gdms-New-Csrf-Token');
                if (newToken) {
                    var ti = form.querySelector('[name="_glpi_csrf_token"]');
                    if (ti) ti.value = newToken;
                }
                return r.blob().then(function(blob) {
                    var a = document.createElement('a');
                    a.href = URL.createObjectURL(blob);
                    a.download = fn;
                    document.body.appendChild(a);
                    a.click();
                    setTimeout(function() { URL.revokeObjectURL(a.href); a.remove(); }, 1000);
                });
            }).finally(function() {
                btn.disabled = false;
                if (spin) spin.classList.add('d-none');
                if (icon) icon.classList.remove('d-none');
            });
        } else {
            if (spin) spin.classList.remove('d-none');
            if (icon) icon.classList.add('d-none');
            setTimeout(function() { btn.disabled = true; }, 0);
        }
    });
});
</script>
