
<style>
.gdms-summary-grid {
   display:grid;
   grid-template-columns:repeat(7,minmax(0,1fr));
   gap:.5rem;
}
.gdms-summary-grid > * { min-width:0; width:auto !important; }
@media (max-width:1199.98px) {
   .gdms-summary-grid { grid-template-columns:repeat(4,minmax(0,1fr)); }
}
@media (max-width:767.98px) {
   .gdms-summary-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
.gdms-sla-card {
   width:100%;
   max-width:none;
   min-width:0;
   box-sizing:border-box;
   overflow:hidden;
}
.gdms-sla-card .card-body {
   min-width:0;
}
.gdms-sla-content {
   min-width:0;
   flex:1 1 auto;
}
.gdms-sla-devices {
   min-width:0;
}
.gdms-sla-device {
   min-width:0;
   max-width:100%;
   overflow-wrap:anywhere;
   word-break:break-word;
}
.gdms-sla-device a,
.gdms-sla-device span {
   overflow-wrap:anywhere;
   word-break:break-word;
}
</style>
{% if not is_configured %}
<div class="container-xl mt-5">
   <div class="card border-0 shadow-sm mx-auto" style="max-width:540px;">
      <div class="card-body text-center py-5 px-4">
         <i class="ti ti-plug text-secondary mb-3" style="font-size:3rem;"></i>
         <h4 class="fw-bold mb-2">{{ __('GDMS not configured yet', 'gdmsintegration') }}</h4>
         <p class="text-muted mb-4">{{ __('To start syncing your Grandstream devices, you need to connect your GDMS Cloud account. It only takes a moment.', 'gdmsintegration') }}</p>
         <a href="{{ config_url }}" class="btn btn-primary px-4">
            <i class="ti ti-settings me-2"></i>{{ __('Set up GDMS', 'gdmsintegration') }}
         </a>
      </div>
   </div>
</div>
{% else %}
<div class="container-fluid px-4 mt-3">

   {# ── Header card ──────────────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-body py-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
         <div class="d-flex align-items-center gap-3">
            <i class="ti ti-antenna text-primary"></i>
            <div>
               <h4 class="mb-0 fw-bold">{{ 'GDMS — ' ~ __('Dashboard', 'gdmsintegration') }}</h4>
               <small class="text-muted">{{ __('Live view of your Grandstream cloud devices', 'gdmsintegration') }}</small>
            </div>
         </div>
         <div class="d-flex align-items-center gap-2">
            {% if last_sync_label %}
            <small class="text-muted" id="gdms-last-sync" title="{{ last_sync_at }}" data-bs-toggle="tooltip">{{ last_sync_label }}</small>
            {% endif %}
            <small class="text-muted" id="gdms-refresh-countdown"></small>
            <button type="button" id="gdms-refresh-btn" class="btn btn-sm btn-outline-primary">
               <i class="ti ti-refresh me-1" id="gdms-refresh-icon"></i>{{ __('Sync now', 'gdmsintegration') }}
            </button>
            <small id="gdms-sync-status" class="text-muted" role="status" aria-live="polite"></small>
            <a href="{{ config_url }}" class="btn btn-sm btn-outline-secondary">
               <i class="ti ti-settings me-1"></i>{{ __('Settings', 'gdmsintegration') }}
            </a>
         </div>
      </div>
   </div>

   {# ── Compact summary cards ─────────────────────────────────────── #}
   <div class="gdms-summary-grid mb-3">
      <div class="gdms-summary-card">
         <div class="card h-100 text-center py-3 px-2">
            <div class="mb-1">
               <i class="ti ti-network text-primary" style="font-size:2rem;"></i>
            </div>
            <div class="small fw-semibold text-muted mb-2" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.03em;">
               {{ __('Networks & clients', 'gdmsintegration') }}
            </div>
            <div class="d-flex justify-content-center gap-3">
               <div>
                  <div class="fw-bold fs-2 lh-1">{{ total_networks }}</div>
                  <div class="text-muted" style="font-size:.78rem;">{{ __('Networks', 'gdmsintegration') }}</div>
               </div>
               <div>
                  <div class="fw-bold fs-2 lh-1 text-info">{{ summary.clients }}</div>
                  <div class="text-muted" style="font-size:.78rem;">{{ __('Connected', 'gdmsintegration') }}</div>
               </div>
            </div>
         </div>
      </div>
      {% set compact_cards = [
         {'icon':'ti-sitemap','label':__('Router','gdmsintegration'),'vals':[{'v':summary.router_on,'lbl':__('Online','gdmsintegration'),'cls':'text-success'},{'v':summary.router_off,'lbl':__('Offline','gdmsintegration'),'cls':'text-danger'}]},
         {'icon':'ti-server','label':__('Switch','gdmsintegration'),'vals':[{'v':summary.switch_on,'lbl':__('Online','gdmsintegration'),'cls':'text-success'},{'v':summary.switch_off,'lbl':__('Offline','gdmsintegration'),'cls':'text-danger'}]},
         {'icon':'ti-wifi','label':'AP','vals':[{'v':summary.ap_on,'lbl':__('Online','gdmsintegration'),'cls':'text-success'},{'v':summary.ap_off,'lbl':__('Offline','gdmsintegration'),'cls':'text-danger'}]},
         {'icon':'ti-phone','label':__('Phones & PBX','gdmsintegration'),'vals':[{'v':summary.phone_on,'lbl':__('Online','gdmsintegration'),'cls':'text-success'},{'v':summary.phone_off,'lbl':__('Offline','gdmsintegration'),'cls':'text-danger'}]}
      ] %}
      {% for card in compact_cards %}
      <div class="gdms-summary-card">
         <div class="card h-100 text-center py-3 px-2">
            <div class="mb-1"><i class="ti {{ card.icon }} text-primary" style="font-size:2rem;"></i></div>
            <div class="small fw-semibold text-muted mb-2" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.03em;">{{ card.label }}</div>
            <div class="d-flex justify-content-center gap-3">
               {% for v in card.vals %}
               <div>
                  <div class="fw-bold fs-2 lh-1 {{ v.cls }}">{{ v.v }}</div>
                  <div class="text-muted" style="font-size:.78rem;">{{ v.lbl }}</div>
               </div>
               {% endfor %}
            </div>
         </div>
      </div>
      {% endfor %}

      {# Operational cards use the same compact visual language as the cards above. #}
      <div class="gdms-summary-card">
         <div class="card h-100 text-center py-3 px-2">
            <div class="mb-1"><i class="ti ti-chart-line text-primary" style="font-size:2rem;"></i></div>
            <div class="small fw-semibold text-muted mb-2" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.03em;">{{ __('Infrastructure health','gdmsintegration') }}</div>
            <div class="fw-bold fs-2 lh-1 {{ ops_summary.health >= 90 ? 'text-success' : (ops_summary.health >= 70 ? 'text-warning' : 'text-danger') }}">{{ ops_summary.health }}%</div>
            <div class="text-muted mt-1" style="font-size:.72rem;line-height:1.25;">{{ __('Based on availability and synchronization — last %d days.','gdmsintegration')|format(chart_days) }}</div>
         </div>
      </div>
      <div class="gdms-summary-card">
         <div class="card h-100 text-center py-3 px-2">
            <div class="mb-1"><i class="ti ti-world text-primary" style="font-size:2rem;"></i></div>
            <div class="small fw-semibold text-muted mb-2" style="font-size:.8rem;text-transform:uppercase;letter-spacing:.03em;">{{ __('WAN status','gdmsintegration') }}</div>
            <div class="fw-bold fs-2 lh-1"><span class="text-success">{{ ops_summary.wan_active }}</span> / <span class="text-danger">{{ ops_summary.wan_down }}</span></div>
            <div class="text-muted mt-1" style="font-size:.72rem;line-height:1.25;">{{ __('WAN links up / down','gdmsintegration') }}</div>
            {% if ops_summary.wan_degraded > 0 %}<div class="text-warning" style="font-size:.72rem;line-height:1.25;">{{ ops_summary.wan_degraded }} {{ __('WAN up, no internet','gdmsintegration') }}</div>{% endif %}
         </div>
      </div>
   </div>

   {# ── Cloud Alerts (GWN only) ───────────────────────────────────── #}
   {% if has_gwn_config %}
   <div class="card mb-4" id="gdms-alerts-card">
      <div class="card-header d-flex align-items-center gap-2" role="button"
           data-bs-toggle="collapse" data-bs-target="#gdms-alerts-collapse"
           aria-expanded="false" aria-controls="gdms-alerts-collapse"
           style="cursor:pointer;">
         <i class="ti ti-bell text-warning"></i>
         <h5 class="mb-0 me-auto">{{ __('Cloud Alerts', 'gdmsintegration') }}</h5>
<i class="ti ti-chevron-down gdms-alerts-chevron" style="transition:transform .2s;"></i>
      </div>
      <div id="gdms-alerts-collapse" class="collapse">
         <div id="gdms-alerts-body" class="card-body py-2">
            <div class="text-center py-2 text-muted small">
               <div class="spinner-border spinner-border-sm me-2"></div>
               {{ __('Loading alerts…', 'gdmsintegration') }}
            </div>
         </div>
      </div>
   </div>
   {% endif %}

   {# ── Availability bar ─────────────────────────────────────────── #}
   <div class="card mb-3 px-3 py-2">
      <div class="d-flex align-items-center gap-3 flex-wrap">
         <span class="small fw-semibold text-nowrap">{{ __('Availability at last synchronization', 'gdmsintegration') }} — {{ __('all devices', 'gdmsintegration') }}</span>
         <div class="progress flex-grow-1" style="height:10px;min-width:120px;">
            <div class="progress-bar {{ pct >= 90 ? 'bg-success' : (pct >= 70 ? 'bg-warning' : 'bg-danger') }}"
                 style="width:{{ pct }}%"></div>
         </div>
         <span class="small fw-bold {{ pct >= 90 ? 'text-success' : (pct >= 70 ? 'text-warning' : 'text-danger') }}">{{ pct }}%</span>
         <span class="text-muted small">{{ online }} / {{ total }} {{ __('online', 'gdmsintegration') }}</span>
      </div>
   </div>

   {# ── Critical SLA banner ──────────────────────────────────────── #}
   {% if critical_devices|length %}
   <div class="card mb-3 border-danger gdms-sla-card" role="alert">
      <div class="card-body py-3 d-flex align-items-start gap-3">
         <i class="ti ti-alert-triangle text-danger mt-1" style="font-size:1.4rem;flex:0 0 auto;"></i>
         <div class="gdms-sla-content">
            <strong class="text-danger">{{ __('Critical SLA — devices offline', 'gdmsintegration') }}</strong>
            <div class="mt-1 small d-flex flex-wrap gap-2 gdms-sla-devices">
            {% for cr in critical_devices %}
               <span class="gdms-sla-device d-inline-flex align-items-center">
                  <i class="ti ti-circle-x text-danger me-1" style="flex:0 0 auto;"></i>
                  {% if cr.asset_url is not empty %}
                  <a href="{{ cr.asset_url }}" target="_blank" rel="noopener" class="text-danger fw-semibold text-decoration-none">{{ cr.name }}</a>
                  {% else %}
                  <span class="fw-semibold">{{ cr.name }}</span>
                  {% endif %}
                  <span class="text-muted ms-1">({{ cr.uptime }}% {{ __('uptime', 'gdmsintegration') }})</span>
               </span>
            {% endfor %}
            </div>
         </div>
      </div>
   </div>
   {% endif %}

   {# ── Device table ─────────────────────────────────────────────── #}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2">
         <i class="ti ti-list"></i>
         <h5 class="mb-0 me-auto">{{ __('Devices', 'gdmsintegration') }}</h5>
         <button type="button" id="gdms-sort-reset" class="btn btn-sm btn-outline-secondary" style="display:none;"
                 title="{{ __('Reset sort', 'gdmsintegration') }}" data-bs-toggle="tooltip">
            <i class="ti ti-arrows-sort"></i> {{ __('Reset sort', 'gdmsintegration') }}
         </button>
      </div>

      {# Vue filter bar — mounted by window.Vue.createApp if available #}
      <div id="gdms-filter-app" class="gdms-filter-toolbar d-flex align-items-center flex-wrap py-3 px-3 border-bottom"
           style="display:none!important;" data-vue-filter>
         <input type="search" v-model="search" id="gdms-device-search" name="search"
                class="form-control form-control-sm gdms-filter-search"
                style="max-width:220px;" :placeholder="strDevice">

         <div class="gdms-filter-set" role="group" aria-label="{{ __('Status', 'gdmsintegration') }}">
            <span class="gdms-filter-label">{{ __('Status', 'gdmsintegration') }}</span>
            <div class="gdms-filter-options">
               <button type="button" class="btn btn-sm gdms-filter-chip"
                       :class="statusFilter==='all'?'btn-secondary':'btn-outline-secondary'"
                       @click="statusFilter='all'" v-text="strAll"></button>
               <button type="button" class="btn btn-sm gdms-filter-chip"
                       :class="statusFilter==='online'?'btn-success':'btn-outline-success'"
                       @click="statusFilter='online'" v-text="strOnline"></button>
               <button type="button" class="btn btn-sm gdms-filter-chip"
                       :class="statusFilter==='offline'?'btn-danger':'btn-outline-danger'"
                       @click="statusFilter='offline'" v-text="strOffline"></button>
            </div>
         </div>

         <div class="gdms-filter-set" role="group" aria-label="{{ __('Type', 'gdmsintegration') }}">
            <span class="gdms-filter-label">{{ __('Type', 'gdmsintegration') }}</span>
            <div class="gdms-filter-options">
               <button type="button" class="btn btn-sm gdms-filter-chip"
                       :class="typeFilter==='all'?'btn-secondary':'btn-outline-secondary'"
                       @click="typeFilter='all'" v-text="strAll"></button>
               <button type="button" class="btn btn-sm gdms-filter-chip"
                       :class="typeFilter==='network'?'btn-primary':'btn-outline-primary'"
                       @click="typeFilter='network'" v-text="strNetwork"></button>
               <button type="button" class="btn btn-sm gdms-filter-chip"
                       :class="typeFilter==='phone'?'btn-info':'btn-outline-info'"
                       @click="typeFilter='phone'" v-text="strPhone"></button>
            </div>
         </div>
      </div>

      <div class="table-responsive">
         <table id="gdms-device-table" class="table table-hover table-sm mb-0">
            <thead>
               <tr>
                  <th class="ps-3 gdms-sortable" data-col="name" style="cursor:pointer;user-select:none;" title="{{ __('Click to sort', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ __('Device Name', 'gdmsintegration') }} <span class="gdms-sort-icon opacity-40">⇅</span></th>
                  <th class="gdms-sortable" data-col="type" style="cursor:pointer;user-select:none;" title="{{ __('Click to sort', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ __('Type', 'gdmsintegration') }} <span class="gdms-sort-icon opacity-40">⇅</span></th>
                  <th class="gdms-sortable" data-col="model" style="cursor:pointer;user-select:none;" title="{{ __('Click to sort', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ __('Model', 'gdmsintegration') }} <span class="gdms-sort-icon opacity-40">⇅</span></th>
                  <th class="gdms-sortable" data-col="network" style="cursor:pointer;user-select:none;" title="{{ __('Click to sort', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ __('Network', 'gdmsintegration') }} <span class="gdms-sort-icon opacity-40">⇅</span></th>
                  <th>{{ __('PBX / UCM', 'gdmsintegration') }}</th>
                  <th>{{ __('IP', 'gdmsintegration') }}</th>
                  <th>{{ __('MAC Address', 'gdmsintegration') }}</th>
                  <th>{{ __('Serial', 'gdmsintegration') }}</th>
                  <th>{{ __('Firmware', 'gdmsintegration') }}</th>
                  <th>{{ __('Ports', 'gdmsintegration') }}</th>
                  <th>{{ __('Uptime', 'gdmsintegration') }}</th>
                  <th class="gdms-sortable" data-col="status" style="cursor:pointer;user-select:none;" title="{{ __('Click to sort', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ __('Status', 'gdmsintegration') }} <span class="gdms-sort-icon opacity-40">⇅</span></th>
                  <th title="{{ __('Cumulative upload / download since device first registered in cloud. Hover a cell for the exact period.', 'gdmsintegration') }}" data-bs-toggle="tooltip" style="cursor:default;">{{ __('Traffic ↑↓', 'gdmsintegration') }} <i class="ti ti-info-circle opacity-50" style="font-size:.75em;"></i></th>
                  <th class="gdms-sortable" data-col="clients" style="cursor:pointer;user-select:none;" title="{{ __('Click to sort', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ __('Clients', 'gdmsintegration') }} <span class="gdms-sort-icon opacity-40">⇅</span></th>
                  <th class="gdms-sortable" data-col="avail" style="cursor:pointer;user-select:none;" title="{{ __('Click to sort', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ __('Avail. %', 'gdmsintegration') }} <span class="gdms-sort-icon opacity-40">⇅</span></th>
                  <th class="gdms-sortable" data-col="sla" style="cursor:pointer;user-select:none;" title="{{ __('Click to sort', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ __('SLA', 'gdmsintegration') }} <span class="gdms-sort-icon opacity-40">⇅</span></th>
               </tr>
            </thead>
            <tbody>
               {% for row_idx, r in rows %}
               <tr data-original-index="{{ row_idx + 1 }}"
                   data-group="{{ r._table_group }}"
                   class="{{ r._table_group_start ? 'gdms-group-start' : '' }}"
                   data-name="{{ r.name|lower }}"
                   data-type="{{ r._is_phone ? 1 : 0 }}"
                   data-model="{{ r.model|lower }}"
                   data-network="{{ r.network_name|lower }}"
                   data-status="{{ r.online ? 0 : 1 }}"
                   data-clients="{{ r.clients }}"
                   data-avail="{{ r.uptime }}"
                   data-sla="{{ r.sla_rank }}">
                  <td class="ps-3">
                     {% if r.asset_url is not empty %}
                     <a href="{{ r.asset_url }}" target="_blank" rel="noopener" class="fw-semibold text-decoration-none">
                        {{ r.name }}
                        <i class="ti ti-external-link ms-1 small opacity-50"></i>
                     </a>
                     {% else %}
                     <span class="fw-semibold">{{ r.name }}</span>
                     {% endif %}
                  </td>
                  <td>
                     {% if r._device_category == 'phone' %}
                     <span class="badge border border-info text-info">{{ __('Phone', 'gdmsintegration') }}</span>
                     {% elseif r._device_category == 'pbx' %}
                     <span class="badge border border-purple text-purple">{{ __('PBX / UCM', 'gdmsintegration') }}</span>
                     {% elseif r._device_category == 'switch' %}
                     <span class="badge border border-primary text-primary">{{ __('Switch', 'gdmsintegration') }}</span>
                     {% elseif r._device_category == 'router' %}
                     <span class="badge border border-secondary" style="color:inherit">{{ __('Router', 'gdmsintegration') }}</span>
                     {% elseif r._device_category == 'ap' %}
                     <span class="badge border border-success text-success">AP</span>
                     {% else %}
                     <span class="badge border border-secondary" style="color:inherit">{{ __('Network', 'gdmsintegration') }}</span>
                     {% endif %}
                  </td>
                  <td><small class="text-muted font-monospace gdms-copy" style="cursor:pointer;"
                             data-copy="{{ r.model }}"
                             title="{{ __('Copy model', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ r.model ?: '—' }}</small></td>
                  <td>
                  {% if r._net_data is not null %}
                  <small class="gdms-net-link"
                      data-net="{{ r._net_data|json_encode }}"
                      style="cursor:pointer;color:inherit;border-bottom:1px dashed rgba(128,128,128,.5);"
                      title="{{ __('Click for network details', 'gdmsintegration') }}" data-bs-toggle="tooltip">
                      {{ r.network_name }}
                      <i class="ti ti-info-circle ms-1 opacity-50" style="font-size:.7em;"></i>
                  </small>
                  {% else %}
                  <small>{{ r.network_name ?: '—' }}</small>
                  {% endif %}
                  </td>
                  <td class="small">
                     {% if r._is_phone and r._pbx is not null %}
                     {% if r._pbx.url is not empty %}
                     <a href="{{ r._pbx.url }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none fw-semibold">{{ r._pbx.name }}</a>
                     {% else %}
                     <span class="fw-semibold">{{ r._pbx.name }}</span>
                     {% endif %}
                     {% if r._pbx.ip is not empty %}
                     {% if r._pbx.ip_url is not empty %}
                     <a href="{{ r._pbx.ip_url }}" target="_blank" rel="noopener noreferrer"
                        class="gdms-pbx-ip-link d-block small font-monospace text-decoration-none"
                        title="{{ r._pbx.name }} — {{ r._pbx.ip }}"
                        aria-label="{{ r._pbx.name }} {{ r._pbx.ip }} (open in a new tab)">
                        {{ r._pbx.ip }} <i class="ti ti-external-link opacity-50" style="font-size:.7em;"></i>
                     </a>
                     {% else %}
                     <small class="d-block text-muted font-monospace">{{ r._pbx.ip }}</small>
                     {% endif %}
                     {% endif %}
                     {% elseif r._is_phone and (r.sip_status is not empty or r.sip_accounts is not empty) %}
                     <span class="text-muted">{{ __('None', 'gdmsintegration') }}</span>
                     {% else %}—{% endif %}
                  </td>
                  <td><small class="font-monospace">
                     {% if r.ip is not empty %}
                     <a href="https://www.whois.com/whois/{{ r.ip|url_encode }}" target="_blank" rel="noopener" class="text-decoration-none" title="{{ __('Public IP', 'gdmsintegration') }}" data-bs-toggle="tooltip">
                        {{ r.ip }} <i class="ti ti-external-link opacity-50" style="font-size:.65em;"></i>
                     </a>
                     {% else %}—{% endif %}
                     {% if r._pref_ip is not empty %}
                     <br><a href="{{ r._pref_ip_href }}" target="_blank" rel="noopener" class="text-muted text-decoration-none" style="font-size:.85em;" title="{{ __('Private IP', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ r._pref_ip }} <i class="ti ti-external-link opacity-50" style="font-size:.65em;"></i></a>
                     {% endif %}
                     {% if r._sec_ip is not empty %}
                     <br><a href="{{ r._sec_ip_href }}" target="_blank" rel="noopener" class="text-muted text-decoration-none" style="font-size:.75em;word-break:break-all;" title="{{ r._sec_ip_is_ipv6 ? 'IPv6' : __('Private IP', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ r._sec_ip }} <i class="ti ti-external-link opacity-50" style="font-size:.65em;"></i></a>
                     {% endif %}
                  </small></td>
                  <td><code class="small gdms-copy" style="cursor:pointer;"
                             data-copy="{{ r.mac }}"
                             title="{{ __('Copy MAC', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ r.mac }}</code></td>
                  <td><small class="text-muted gdms-copy" style="cursor:pointer;"
                             data-copy="{{ r.serial }}"
                             title="{{ __('Copy serial', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ r.serial ?: '—' }}</small></td>
                  <td class="text-nowrap">
                     {% if r.firmware is not empty %}
                     <small class="font-monospace text-muted gdms-fw-badge" style="cursor:pointer;"
                            data-mac="{{ r.mac|lower }}"
                            data-current="{{ r.firmware }}"
                            data-model="{{ r.raw_model }}"
                            data-name="{{ r.name }}"
                            data-ip="{{ r.private_ip }}"
                            title="{{ __('Click to check firmware', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ r.firmware }}</small>
                     <span class="gdms-fw-badge" style="{{ r._fw_badge_shown ? '' : 'display:none; ' }}cursor:pointer;"
                           data-mac="{{ r.mac|lower }}"
                           data-current="{{ r.firmware }}"
                           data-model="{{ r.raw_model }}"
                           data-name="{{ r.name }}"
                           data-ip="{{ r.private_ip }}"
                           title="{{ __('Firmware update available', 'gdmsintegration') }}" data-bs-toggle="tooltip">
                        <i class="ti ti-arrow-up-circle text-warning ms-1"></i>
                     </span>
                     {% else %}
                     <small class="font-monospace text-muted">—</small>
                     {% endif %}
                  </td>
                  <td>
                     {% if not r._is_phone and r.mac is not empty %}
                     <span class="gdms-wan-ports d-flex gap-1 align-items-center flex-nowrap"
                           data-mac="{{ r.mac|lower }}"
                           data-upload="{{ r.upload_bytes }}"
                           data-download="{{ r.download_bytes }}"
                           data-first-seen="{{ r.first_seen }}"
                           data-last-seen="{{ r.last_seen }}">
                        <span class="text-muted small">—</span>
                     </span>
                     {% elseif r._is_phone and (r.sip_status is not empty or r.sip_accounts is not empty) %}
                     <span class="gdms-sip-dot" style="cursor:pointer;display:inline-flex;align-items:center;gap:4px;"
                           title="{{ r._sip_tip }}"
                           data-bs-toggle="tooltip"
                           data-pbx-name="{{ r._pbx.name ?? '' }}"
                           data-pbx-ip="{{ r._pbx.ip ?? '' }}"
                           data-pbx-url="{{ r._pbx.url ?? '' }}"
                           data-mac="{{ r.mac }}"
                           data-sip="{{ r.sip_status is not empty ? r.sip_status : 'unknown' }}"
                           data-dnd="{{ r.dnd }}"
                           data-sync="{{ r.is_synchronized }}"
                           data-sync-msg="{{ r.sync_failure_msg }}"
                           data-task="{{ r.scheduled_task }}"
                           data-extension="{{ r.sip_extension }}"
                           data-sip-accounts="{{ r._sip_accounts_display|json_encode|e('html_attr') }}"
                           data-last-seen="{{ r.last_seen }}"
                           data-private-ip="{{ r.private_ip }}"
                           data-public-ip="{{ r.ip }}"
                           data-site="{{ r.network_name }}"
                           data-name="{{ r.name }}">
                        <span style="display:inline-block;width:9px;height:9px;border-radius:50%;background:{{ r._sip_color }};outline:1px solid rgba(128,128,128,.3);{{ not r.online ? 'opacity:.4;' : '' }}flex-shrink:0;"></span>
                        {% if r.dnd %}
                        <small class="text-danger" style="font-size:.65em;line-height:1;">DND</small>
                        {% endif %}
                     </span>
                     {% endif %}
                  </td>
                  <td>
                  {% if r._uptime_tip %}
                  <small title="{{ r._uptime_tip }}" data-bs-toggle="tooltip" style="cursor:default;border-bottom:1px dotted rgba(128,128,128,.4);">{{ r._uptime_display }}</small>
                  {% else %}
                  <small>{{ r._uptime_display }}</small>
                  {% endif %}
                  </td>
                  <td class="text-nowrap">
                     <span class="badge {{ r.online ? 'bg-success' : 'bg-danger' }} text-white">
                        {{ r.online ? __('Online', 'gdmsintegration') : __('Offline', 'gdmsintegration') }}
                     </span>
                     {% if r.sip_accounts is not empty %}
                     <br><span class="d-inline-flex flex-wrap gap-1 mt-1">
                        {% for account in r.sip_accounts %}
                        {% if account.extension is not empty %}
                        <span class="badge bg-light text-dark border" style="font-size:.68em;" title="{{ __('SIP Extension', 'gdmsintegration') }} · {{ account.status|default('') }}">
                           {{ account.extension }}
                        </span>
                        {% endif %}
                        {% endfor %}
                     </span>
                     {% elseif r.sip_extension is not empty %}
                     <br><span class="badge bg-light text-dark border mt-1" style="font-size:.68em;" title="{{ __('SIP Extension', 'gdmsintegration') }}" data-bs-toggle="tooltip">
                        {{ r.sip_extension }}
                     </span>
                     {% endif %}
                  </td>
                  <td class="text-nowrap">
                     {% if r._ul_val > 0 or r._dl_val > 0 %}
                     <small class="d-block"
                            title="{{ r._traffic_tip }}" data-bs-toggle="tooltip"
                            style="font-size:.72em;cursor:default;border-bottom:1px dotted rgba(128,128,128,.4);">
                        <span class="text-success">↑{{ r._ul_fmt }}</span>
                        <span class="ms-1 text-info">↓{{ r._dl_fmt }}</span>
                     </small>
                     {% else %}<small class="text-muted">—</small>{% endif %}
                  </td>
                  <td class="text-center">
                     {% set cli = r.clients %}
                     {% if cli > 0 and r.network_id > 0 %}
                     <span class="badge text-bg-info fw-bold gdms-clients-badge"
                           style="cursor:pointer;"
                           data-mac="{{ r.mac }}"
                           data-network-id="{{ r.network_id }}"
                           data-name="{{ r.name }}"
                           title="{{ __('Click to see connected clients', 'gdmsintegration') }}" data-bs-toggle="tooltip">{{ cli }}</span>
                     {% elseif cli > 0 %}
                     <span class="badge text-bg-info fw-bold">{{ cli }}</span>
                     {% else %}<small class="text-muted">—</small>{% endif %}
                  </td>
                  <td>{{ r.uptime }}%</td>
                  <td>{{ r.sla }}</td>
               </tr>
               {% else %}
               <tr><td colspan="15" class="text-center text-muted py-3">
                  {{ __('No GDMS devices found. Run a sync first.', 'gdmsintegration') }}
               </td></tr>
               {% endfor %}
            </tbody>
         </table>
      </div>
   </div>

   {# ── History chart ─────────────────────────────────────────────── #}
   {% if chart_datasets|length %}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2">
         <i class="ti ti-chart-line"></i>
         <h5 class="mb-0 me-auto">{{ __('Online %% — last %d days', 'gdmsintegration')|format(chart_days) }}</h5>
         <a href="{{ urls.history_export }}"
            class="btn btn-sm btn-outline-secondary"
            title="{{ __('Export to XLSX', 'gdmsintegration') }}" data-bs-toggle="tooltip">
            <i class="ti ti-file-spreadsheet me-1"></i>{{ __('Export', 'gdmsintegration') }}
         </a>
      </div>
      <div class="card-body p-0">
         <div id="gdms-history-chart" style="height:280px;"></div>
      </div>
   </div>
   {% endif %}

   {# ── Topology ──────────────────────────────────────────────────── #}
   {% if show_topology %}
   <div class="card mb-4">
      <div class="card-header d-flex align-items-center gap-2">
         <i class="ti ti-hierarchy"></i>
         <h5 class="mb-0">{{ __('Network Topology', 'gdmsintegration') }}</h5>
      </div>
      <div id="gdms-network" style="height:450px; border-radius:0 0 .375rem .375rem; overflow:hidden;"></div>
   </div>
   {% endif %}

   <textarea id="gdms-dashboard-data" hidden aria-hidden="true">{{ dashboard_data_json }}</textarea>
</div>

<style>
@keyframes spin { to { transform: rotate(360deg); } }
#gdms-filter-app.gdms-filter-toolbar { gap: .7rem .85rem; }
#gdms-filter-app .gdms-filter-set {
   display: flex;
   align-items: center;
   flex-wrap: wrap;
   gap: .4rem;
   min-height: 2.35rem;
   padding: .35rem .55rem;
   border: 1px solid var(--tblr-border-color, rgba(128,128,128,.35));
   border-radius: .7rem;
   background: var(--tblr-bg-surface-secondary, rgba(128,128,128,.06));
}
#gdms-filter-app .gdms-filter-label {
   color: var(--tblr-muted, #7b8495);
   font-size: .65rem;
   font-weight: 700;
   letter-spacing: .055em;
   line-height: 1;
   text-transform: uppercase;
   white-space: nowrap;
   padding: 0 .15rem;
}
#gdms-filter-app .gdms-filter-options { display: flex; align-items: center; flex-wrap: wrap; gap: .3rem; }
#gdms-filter-app .gdms-filter-chip {
   border-radius: 999px !important;
   padding: .27rem .68rem;
   font-size: .76rem;
   font-weight: 600;
   line-height: 1.25;
   transition: box-shadow .15s ease, transform .15s ease, background-color .15s ease;
}
#gdms-filter-app .gdms-filter-chip:hover { transform: translateY(-1px); box-shadow: 0 .15rem .35rem rgba(0,0,0,.12); }
#gdms-filter-app .gdms-filter-chip:focus-visible { outline: 2px solid var(--tblr-primary, #206bc4); outline-offset: 2px; }
#gdms-device-table .gdms-pbx-ip-link { width: fit-content; color: var(--tblr-muted, #7b8495); }
#gdms-device-table .gdms-pbx-ip-link:hover { color: var(--tblr-primary, #206bc4); text-decoration: underline !important; }
@media (max-width: 575.98px) {
   #gdms-filter-app .gdms-filter-search { flex: 1 1 100%; width: 100%; max-width: none !important; }
   #gdms-filter-app .gdms-filter-set { flex: 1 1 auto; }
}
#gdms-device-table tbody tr.gdms-group-start > td { border-top: 3px solid var(--tblr-border-color, rgba(128,128,128,.45)); }
#gdms-device-table tbody tr[data-group="pbx"] > td:first-child { border-left: 3px solid var(--tblr-purple, #6f42c1); }
#gdms-device-table tbody tr[data-group="phone"] > td:first-child { border-left: 3px solid var(--tblr-info, #4299e1); }
</style>


{% endif %}
